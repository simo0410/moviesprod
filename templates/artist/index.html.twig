{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    <table border="1">
        <thead>
            <tr>
                <th>Firstname</th>
                <th>Lastname</th>
            </tr>
        </thead>
        <tbody>
        {% for artist in artists %}
            <tr>
                <td><a href="{{ path('app_artist_show', {id: artist.id}) }}">{{ artist.firstname|capitalize }}</a></td>
                <td>{{ artist.lastname|upper }}</td>
            </tr>  
         {% endfor %}
        </tbody>
    </table>
       
    
{% endblock %}
