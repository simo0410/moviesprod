{% extends 'base.html.twig' %}

{% block title %}Films MoviesProd{% endblock %}

{% block body %}
    <h1>Liste des films</h1>
    <ul>
        {% for film in films %}
            <li>
                <h2><a href="{{ path('app_film_show', {id: film.id}) }}">{{ film.titre }}</a></h2>

                - {{ film.description }} - {{ film.category.nom }}

                {% if film.artists is not empty %}
                    {% for artist in film.artists %}
                        <li>
                            <h3>
                                <a href="{{ path('app_artist_show', {id: artist.id}) }}">{{ artist.firstname }} {{ artist.lastname }}</a>
                            </h3>
                        </li>
                    
                    {% endfor %}
                {% endif %}
            </li>
            
            
        {% endfor %} 
    </ul>

{% endblock %}
